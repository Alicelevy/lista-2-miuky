
nota1 = float(input("Digite a primeira nota: "))
nota2 = float(input("Digite a segunda nota: "))

media = (nota1 + nota2) / 2

if media >= 6.0:
    print(f"Aluno APROVADO com média: {media:.2f}")
else:
    print(f"Média inicial: {media:.2f}")
    exame = float(input("Digite a nota do exame: "))
    nova_media = (media + exame) / 2
    
    if nova_media >= 5.0:
        print(f"Aluno APROVADO EM EXAME com média: {nova_media:.2f}")
    else:
        print(f"Aluno REPROVADO com média: {nova_media:.2f}")
