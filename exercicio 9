
num1 = int(input("Digite o primeiro número inteiro: "))
num2 = int(input("Digite o segundo número inteiro: "))

divisiveis = []

if num1 % 4 == 0 or num1 % 5 == 0:
    divisiveis.append(num1)

if num2 % 4 == 0 or num2 % 5 == 0:
    divisiveis.append(num2)

if divisiveis:
    print(f"Números divisíveis por 4 ou 5: {divisiveis}")
else:
    print("Nenhum número é divisível por 4 ou 5")
