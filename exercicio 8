
numeros = []
for i in range(3):
    num = int(input(f"Digite o {i+1}º número inteiro: "))
    numeros.append(num)

divisiveis = [num for num in numeros if num % 2 == 0 and num % 3 == 0]

if divisiveis:
    print(f"Números divisíveis por 2 e 3: {divisiveis}")
else:
    print("Nenhum número é divisível por 2 e 3 simultaneamente")
