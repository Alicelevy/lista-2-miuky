
mes = int(input("Digite o número do mês (1-12): "))

match mes:
    case 1:
        nome_mes = "Janeiro"
    case 2:
        nome_mes = "Fevereiro"
    case 3:
        nome_mes = "Março"
    case 4:
        nome_mes = "Abril"
    case 5:
        nome_mes = "Maio"
    case 6:
        nome_mes = "Junho"
    case 7:
        nome_mes = "Julho"
    case 8:
        nome_mes = "Agosto"
    case 9:
        nome_mes = "Setembro"
    case 10:
        nome_mes = "Outubro"
    case 11:
        nome_mes = "Novembro"
    case 12:
        nome_mes = "Dezembro"
    case _:
        nome_mes = "Mês inválido!"

print(f"Mês: {nome_mes}")
